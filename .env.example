# Copy to .env.local and fill in. Never commit .env.local.
# Neon Postgres (free plan). Pooled connection for the app, direct connection for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Shared secret that protects the daily ingestion endpoint (used from Phase 7).
CRON_SECRET=

# TCBS OpenAPI (used from Phase 1). Enter these yourself in environment settings; never in chat.
TCBS_API_KEY=
